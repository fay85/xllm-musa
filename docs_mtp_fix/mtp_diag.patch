diff --git a/xllm/core/layers/musa/mtp_diag_tmp.h b/xllm/core/layers/musa/mtp_diag_tmp.h
new file mode 100644
--- /dev/null
+++ b/xllm/core/layers/musa/mtp_diag_tmp.h
@@ -0,0 +1,25 @@
+#pragma once
+// TEMPORARY MTP NaN diagnostics (env XLLM_MTP_DIAG_FWD). Not for commit.
+#include <glog/logging.h>
+#include <musa_runtime.h>
+#include <torch/torch.h>
+#include <atomic>
+#include <cstdlib>
+#include "torch_musa/csrc/core/MUSAStream.h"
+namespace xllm::layer::mtp_diag_tmp {
+inline bool on(int64_t tokens) {
+  static const bool env = std::getenv("XLLM_MTP_DIAG_FWD") != nullptr;
+  static std::atomic<int> cnt{0};
+  if (!env || tokens > 4) return false;
+  musaStreamCaptureStatus st = musaStreamCaptureStatusNone;
+  musaStreamIsCapturing(c10::musa::getCurrentMUSAStream().stream(), &st);
+  return st == musaStreamCaptureStatusNone && cnt.fetch_add(1) < 400;
+}
+inline void log(bool enabled, const char* n, const torch::Tensor& t) {
+  if (!enabled || !t.defined()) return;
+  torch::Tensor f = t.to(torch::kFloat32);
+  LOG(INFO) << "[MTP_L] " << n << " " << t.sizes() << " " << t.dtype()
+            << " nan=" << f.isnan().sum().item<int64_t>()
+            << " absmax=" << f.nan_to_num(0, 0, 0).abs().max().item<float>();
+}
+}  // namespace xllm::layer::mtp_diag_tmp
