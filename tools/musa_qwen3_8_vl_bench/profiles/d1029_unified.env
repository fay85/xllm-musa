# Frozen native-image K2 profile qualified on d1029-opt3; not /workspace/config.json.
: "${XLLM_PACK_ROOT:?Set XLLM_PACK_ROOT to the unified bundle or extracted xllm_pack}"
PROFILE_MEMORY_UTILIZATION=0.90
PROFILE_CREDIT_CAP=8192
PROFILE_GRAPH_VMM_POOL=false
PROFILE_MTP_K=2
VL_SKIP_CONFIG=1
VL_XLLM_BIN=${VL_XLLM_BIN:-$XLLM_PACK_ROOT/decode/xllm}
VL_PREFILL_XLLM_BIN=${VL_PREFILL_XLLM_BIN:-$XLLM_PACK_ROOT/prefill/xllm}
VL_DECODE_XLLM_BIN=${VL_DECODE_XLLM_BIN:-$XLLM_PACK_ROOT/decode/xllm}
VL_XLLM_LIB_DIR=${VL_XLLM_LIB_DIR:-$XLLM_PACK_ROOT/decode}
VL_MUSA_OPS_DIR=${VL_MUSA_OPS_DIR:-$XLLM_PACK_ROOT/qwen_cached_ops}
PROFILE_MASTER_BIN=/opt/xllm_service/bin/xllm_master_serving.rr_probe_fix_20261024
# A full pack contains these pinned files; engine-only bundles use the base image.
if [[ -f $XLLM_PACK_ROOT/service/qwen/xllm_master_serving ]]; then
  PROFILE_MASTER_BIN=$XLLM_PACK_ROOT/service/qwen/xllm_master_serving
  VL_RUST_TOKENIZERS_LIB=${VL_RUST_TOKENIZERS_LIB:-$XLLM_PACK_ROOT/service/qwen/librust_tokenizers.so}
fi
if [[ -f $XLLM_PACK_ROOT/bootstrap/libmusa_backend_init.so ]]; then
  VL_MUSA_PRELOAD=${VL_MUSA_PRELOAD:-$XLLM_PACK_ROOT/bootstrap/libmusa_backend_init.so}
fi
if [[ -f $XLLM_PACK_ROOT/etcd/etcd ]]; then
  VL_ETCD_BIN=${VL_ETCD_BIN:-$XLLM_PACK_ROOT/etcd/etcd}
fi
export MATE_MUBIN_DIR=${MATE_MUBIN_DIR:-$XLLM_PACK_ROOT/mate_mubin}
VL_MASTER_TOKENIZER=${VL_MASTER_TOKENIZER:-/root/xllm_vl_bench/master_tokenizer}
VL_PROMPTS=${VL_PROMPTS:-/root/xllm_vl_bench/vl_prompts_text20k_pm1k.json}
