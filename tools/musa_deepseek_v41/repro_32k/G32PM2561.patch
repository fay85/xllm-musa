diff --git a/xllm/core/layers/musa/deepseek_v41/normal_transport.h b/xllm/core/layers/musa/deepseek_v41/normal_transport.h
new file mode 100644
index 000000000..bccd82bca
--- /dev/null
+++ b/xllm/core/layers/musa/deepseek_v41/normal_transport.h
@@ -0,0 +1,104 @@
+/* Copyright 2026 The xLLM Authors. All Rights Reserved.
+SPDX-License-Identifier: Apache-2.0
+==============================================================================*/
+#pragma once
+
+#include <pybind11/embed.h>
+#include <torch/torch.h>
+#include <torch/utils.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <tuple>
+
+namespace xllm::layer {
+
+// The vendor normal-mode transport returns one received row per destination
+// rank, with local expert IDs and -1 for routes processed by other ranks.
+// The rank's FP32 local contributions are packed to BF16 for normal combine.
+class DeepseekV41NormalTransport final {
+ public:
+  DeepseekV41NormalTransport(const pybind11::object& group,
+                             int64_t world,
+                             int64_t hidden,
+                             int64_t experts)
+      : experts_(experts) {
+    CHECK_EQ(world, 8);
+    const auto ep = pybind11::module_::import("deep_ep");
+    const auto config = ep.attr("Config");
+    dispatch_config_ =
+        config(pybind11::arg("num_sms") = 32,
+               pybind11::arg("num_max_nvl_chunked_send_tokens") = 26);
+    combine_config_ =
+        config(pybind11::arg("num_sms") = 32,
+               pybind11::arg("num_max_nvl_chunked_send_tokens") = 16);
+    const auto bytes = [&](const char* method) {
+      return std::max(
+          dispatch_config_.attr(method)(hidden * 2, world).cast<int64_t>(),
+          combine_config_.attr(method)(hidden * 2, world).cast<int64_t>());
+    };
+    const int64_t nvl = bytes("get_nvl_buffer_size_hint");
+    const int64_t rdma = bytes("get_rdma_buffer_size_hint");
+    CHECK_GT(nvl, 0);
+    buffer_ = ep.attr("Buffer")(group,
+                                pybind11::arg("num_nvl_bytes") = nvl,
+                                pybind11::arg("num_rdma_bytes") = rdma,
+                                pybind11::arg("num_qps_per_rank") = 32);
+    LOG(INFO) << "V41_NORMAL_EP_BUFFER nvl_bytes=" << nvl
+              << " rdma_bytes=" << rdma;
+  }
+
+  std::tuple<torch::Tensor, torch::Tensor, torch::Tensor> dispatch(
+      const torch::Tensor& x,
+      const torch::Tensor& ids,
+      const torch::Tensor& weights) {
+    CHECK(!handle_ && x.is_contiguous() && ids.is_contiguous() &&
+          weights.is_contiguous());
+    CHECK_EQ(x.dim(), 2);
+    CHECK_EQ(ids.dim(), 2);
+    CHECK_EQ(x.size(0), ids.size(0));
+    CHECK_EQ(ids.sizes(), weights.sizes());
+    CHECK_EQ(x.scalar_type(), torch::kBFloat16);
+    CHECK_EQ(ids.scalar_type(), torch::kInt64);
+    CHECK_EQ(weights.scalar_type(), torch::kFloat32);
+    pybind11::gil_scoped_acquire gil;
+    const pybind11::tuple layout =
+        buffer_.attr("get_dispatch_layout")(ids, experts_);
+    CHECK_EQ(layout.size(), 5);
+    const pybind11::tuple recv = buffer_.attr("dispatch")(
+        x,
+        pybind11::arg("topk_idx") = ids,
+        pybind11::arg("topk_weights") = weights,
+        pybind11::arg("num_tokens_per_rank") = layout[0],
+        pybind11::arg("num_tokens_per_rdma_rank") = layout[1],
+        pybind11::arg("num_tokens_per_expert") = layout[2],
+        pybind11::arg("is_token_in_rank") = layout[3],
+        pybind11::arg("expert_alignment") = 1,
+        pybind11::arg("config") = dispatch_config_);
+    CHECK_EQ(recv.size(), 6);
+    handle_ = recv[4];
+    return {recv[0].cast<torch::Tensor>(),
+            recv[1].cast<torch::Tensor>(),
+            recv[2].cast<torch::Tensor>()};
+  }
+
+  torch::Tensor combine(const torch::Tensor& contribution) {
+    CHECK(handle_ && contribution.is_contiguous());
+    CHECK_EQ(contribution.scalar_type(), torch::kBFloat16);
+    pybind11::gil_scoped_acquire gil;
+    const pybind11::tuple output = buffer_.attr("combine")(
+        contribution, handle_, pybind11::arg("config") = combine_config_);
+    CHECK_EQ(output.size(), 3);
+    torch::Tensor local = output[0].cast<torch::Tensor>();
+    handle_ = pybind11::object();
+    return local;
+  }
+
+ private:
+  int64_t experts_;
+  pybind11::object buffer_;
+  pybind11::object handle_;
+  pybind11::object dispatch_config_;
+  pybind11::object combine_config_;
+};
+}  // namespace xllm::layer
