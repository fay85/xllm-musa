+}
+torch::Tensor deepseek_v41_ragged_s4fp8_gemm(const torch::Tensor& input,
+                                             const torch::Tensor& input_scale,
+                                             const torch::Tensor& weight,
+                                             const torch::Tensor& weight_scale,
+                                             const torch::Tensor& labels,
+                                             const std::string& directory,
+                                             int64_t alignment) {
+  CHECK_EQ(input.dim(), 2);
+  CHECK_EQ(weight.dim(), 3);
+  CHECK_EQ(labels.dim(), 1);
+  CHECK_EQ(input.size(0), labels.numel());
+  CHECK(alignment == 128 || alignment == 256);
+  CHECK_EQ(input.size(0) % alignment, 0);
+  CHECK_EQ(input.size(1), weight.size(2) * 2);
+  CHECK_EQ(input_scale.size(0), input.size(0));
+  CHECK_EQ(input_scale.dim(), 2);
+  CHECK_EQ(input_scale.size(1), 1);
+  CHECK_EQ(weight_scale.dim(), 3);
+  CHECK_EQ(weight_scale.size(0), weight.size(0));
+  CHECK_EQ(weight_scale.size(1), weight.size(1));
+  CHECK_EQ(weight_scale.size(2) * 128, input.size(1));
+  CHECK_EQ(input.scalar_type(), torch::kFloat8_e4m3fn);
+  CHECK_EQ(weight.scalar_type(), torch::kInt8);
+  CHECK_EQ(input_scale.scalar_type(), torch::kFloat32);
+  CHECK_EQ(weight_scale.scalar_type(), torch::kBFloat16);
+  CHECK_EQ(labels.scalar_type(), torch::kInt32);
+  for (const auto& t : {input, input_scale, weight, weight_scale, labels}) {
+    CHECK_EQ(t.device(), input.device());
+    CHECK(t.is_contiguous());
+  }
+  struct Provider {
+    std::string root;
+    int64_t alignment;
+    std::array<std::string, 2> symbol;
+    explicit Provider(const std::string& path, int64_t m)
+        : root(path), alignment(m) {
+      std::ifstream stream(root + "/provider-progress.json");
+      CHECK(stream.good());
+      const auto record = nlohmann::json::parse(stream);
+      for (int i = 0; i < 2; ++i)
+        symbol[i] = record
+                        .at("m" + std::to_string(alignment) + "-hint" +
+                            std::to_string(i))
+                        .at("launch")
+                        .get<std::string>();
+    }
+  };
+  // Load a width only when its real row layout is selected.
+  const auto& provider = [&]() -> const Provider& {
+    if (alignment == 256) {
+      static const Provider wide(directory, 256);
+      return wide;
+    }
+    static const Provider ordinary(directory, 128);
+    return ordinary;
+  }();
+  CHECK_EQ(provider.root, directory);
+  const int hint = (input.size(0) <= 192 * weight.size(0)) ? 1 : 0;
+  const auto base = directory + "/provider/m" + std::to_string(alignment) +
+                    "-hint" + std::to_string(hint);
+  const auto run =
+      get_function_from_file(base + "/launcher.so", provider.symbol[hint]);
+  auto out = torch::empty({input.size(0), weight.size(1)},
+                          input.options().dtype(torch::kBFloat16));
+  TvmffiStreamGuard stream(input.device());
+  run(ffi::String(base + "/kernel.mubin"),
+      to_ffi_tensor(input),
+      to_ffi_tensor(weight),
+      to_ffi_tensor(out),
+      to_ffi_tensor(input_scale),
+      to_ffi_tensor(weight_scale),
+      nullptr,
+      to_ffi_tensor(labels),
+      nullptr,
+      nullptr,
+      nullptr);
+  return out;
+}
