diff --git a/xllm/core/kernels/musa/deepseek_v41_w4a8.cu b/xllm/core/kernels/musa/deepseek_v41_w4a8.cu
index 3a80faca1..6c500bd8d 100644
--- a/xllm/core/kernels/musa/deepseek_v41_w4a8.cu
+++ b/xllm/core/kernels/musa/deepseek_v41_w4a8.cu
@@ -13,0 +14 @@ SPDX-License-Identifier: Apache-2.0
+#include "core/util/env_var.h"
@@ -522,0 +524,222 @@ torch::Tensor deepseek_v41_w4a8_combine(const torch::Tensor& expert_output,
+namespace {
+__global__ void ragged_route_counts(const int64_t* ids,
+                                    int32_t* counts,
+                                    int32_t* links,
+                                    int routes,
+                                    int first,
+                                    int experts) {
+  const int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= routes) return;
+  const int64_t e = ids[i] - first;
+  links[i] = e < 0 || e >= experts ? -1 : atomicAdd(counts + e, 1);
+}
+
+__global__ void ragged_offsets(const int32_t* counts,
+                               int32_t* offsets,
+                               int experts,
+                               int alignment) {
+  int total = 0;
+  for (int e = 0; e < experts; ++e) {
+    offsets[e] = total;
+    total += (counts[e] + alignment - 1) / alignment * alignment;
+  }
+  offsets[experts] = total;
+}
+
+__global__ void ragged_pack_static(const c10::BFloat16* input,
+                                   const int64_t* ids,
+                                   const int32_t* offsets,
+                                   int32_t* links,
+                                   int32_t* labels,
+                                   c10::Float8_e4m3fn* q,
+                                   int hidden,
+                                   int topk,
+                                   int first,
+                                   float scale) {
+  const int route = blockIdx.x;
+  // Every thread must see the original local row before the shared link is
+  // updated.
+  __shared__ int slot;
+  if (threadIdx.x == 0) {
+    const int local = links[route];
+    slot = local < 0 ? -1 : offsets[ids[route] - first] + local;
+    links[route] = slot;
+    if (slot >= 0) labels[slot] = static_cast<int32_t>(ids[route] - first);
+  }
+  __syncthreads();
+  if (slot < 0) return;
+  const int64_t in = static_cast<int64_t>(route / topk) * hidden;
+  const int64_t out = static_cast<int64_t>(slot) * hidden;
+  for (int i = threadIdx.x; i < hidden; i += blockDim.x) {
+    q[out + i] = c10::Float8_e4m3fn(
+        fminf(448.f, fmaxf(-448.f, static_cast<float>(input[in + i]) / scale)));
+  }
+}
+
+__global__ void ragged_swiglu_static(const c10::BFloat16* source,
+                                     const int32_t* labels,
+                                     c10::Float8_e4m3fn* q,
+                                     int width,
+                                     float limit,
+                                     float inverse) {
+  const int row = blockIdx.x;
+  if (labels[row] < 0) return;
+  const int64_t start = static_cast<int64_t>(row) * width;
+  for (int col = threadIdx.x; col < width; col += blockDim.x) {
+    const float gate =
+        fminf(static_cast<float>(source[2 * start + col]), limit);
+    const float up = fminf(
+        limit,
+        fmaxf(-limit, static_cast<float>(source[2 * start + width + col])));
+    q[start + col] = c10::Float8_e4m3fn(fminf(
+        448.f, fmaxf(-448.f, (gate / (1.f + __expf(-gate))) * up * inverse)));
+  }
+}
+
+__global__ void ragged_combine_fp32(const c10::BFloat16* expert,
+                                    const int32_t* links,
+                                    const float* weights,
+                                    float* output,
+                                    int width,
+                                    int topk) {
+  const int token = blockIdx.y;
+  const int col = blockIdx.x * blockDim.x + threadIdx.x;
+  if (col >= width) return;
+  float sum = 0.f;
+  for (int k = 0; k < topk; ++k) {
+    const int route = token * topk + k;
+    const int row = links[route];
+    if (row >= 0)
+      sum +=
+          weights[route] *
+          static_cast<float>(expert[static_cast<int64_t>(row) * width + col]);
+  }
+  output[static_cast<int64_t>(token) * width + col] = sum;
+}
+}  // namespace
+
+torch::Tensor deepseek_v41_prefill_ragged_experts(
+    const torch::Tensor& input,
+    const torch::Tensor& ids,
+    const torch::Tensor& weights,
+    const torch::Tensor& gate_up,
+    const torch::Tensor& gate_scale,
+    const torch::Tensor& down,
+    const torch::Tensor& down_scale,
+    int64_t first,
+    double input_scale,
+    double activation_scale,
+    double limit,
+    const std::string& directory) {
+  const auto dev = input.device();
+  CHECK(dev.is_privateuseone());
+  check_gpu_contiguous(input, dev, torch::kBFloat16);
+  check_gpu_contiguous(ids, dev, torch::kInt64);
+  check_gpu_contiguous(weights, dev, torch::kFloat32);
+  CHECK_EQ(input.dim(), 2);
+  CHECK_EQ(ids.dim(), 2);
+  CHECK_EQ(weights.sizes(), ids.sizes());
+  CHECK_EQ(ids.size(0), input.size(0));
+  CHECK_GT(ids.size(1), 0);
+  CHECK_LE(ids.size(1), 32);
+  CHECK_GT(input.size(0), 0);
+  CHECK_LE(input.size(0), 8192);
+  CHECK(input_scale > 0 && std::isfinite(input_scale) && activation_scale > 0 &&
+        std::isfinite(activation_scale));
+  const int64_t e = gate_up.size(0), width = input.size(1),
+                inner = gate_up.size(1) / 2;
+  CHECK_GT(e, 0);
+  CHECK_LE(e, 1024);
+  CHECK_EQ(gate_up.size(1), 2 * inner);
+  CHECK_EQ(width, 2 * gate_up.size(2));
+  CHECK_EQ(down.size(0), e);
+  CHECK_EQ(down.size(1), width);
+  CHECK_EQ(2 * down.size(2), inner);
+  torch::DeviceGuard guard(dev);
+  const auto stream = current_musa_stream(dev);
+  const auto i32 = input.options().dtype(torch::kInt32);
+  const auto f32 = input.options().dtype(torch::kFloat32);
+  const auto fp8 = input.options().dtype(torch::kFloat8_e4m3fn);
+  torch::Tensor counts = torch::zeros({e}, i32),
+                offsets = torch::empty({e + 1}, i32);
+  torch::Tensor links = torch::empty(ids.sizes(), i32);
+  ragged_route_counts<<<(ids.numel() + 255) / 256, 256, 0, stream>>>(
+      ids.data_ptr<int64_t>(),
+      counts.data_ptr<int32_t>(),
+      links.data_ptr<int32_t>(),
+      ids.numel(),
+      first,
+      e);
+  check_musa_kernel_launch("V4.1 segmented expert route counts");
+  // Same input geometry and packed expert width as the guide's normal MoE.
+  static const bool use_m256 =
+      util::get_bool_env("XLLM_DSV41_PREFILL_RAGGED_M256", false);
+  const int alignment = use_m256 && input.size(0) >= 1024 && e == 48 &&
+                                inner == 2304 && width == 5120 &&
+                                ids.size(1) == 6
+                            ? 256
+                            : 128;
+  ragged_offsets<<<1, 1, 0, stream>>>(
+      counts.data_ptr<int32_t>(), offsets.data_ptr<int32_t>(), e, alignment);
+  check_musa_kernel_launch("V4.1 segmented expert offsets");
+  const int total = offsets.select(0, e).item<int32_t>();
+  CHECK_GE(total, 0);
+  CHECK_LE(total, ids.numel() + e * (alignment - 1));
+  if (!total) return torch::zeros(input.sizes(), f32);
+  auto labels = torch::full({total}, -1, i32);
+  auto q = torch::zeros({total, width}, fp8);
+  ragged_pack_static<<<ids.numel(), 256, 0, stream>>>(
+      input.data_ptr<c10::BFloat16>(),
+      ids.data_ptr<int64_t>(),
+      offsets.data_ptr<int32_t>(),
+      links.data_ptr<int32_t>(),
+      labels.data_ptr<int32_t>(),
+      q.data_ptr<c10::Float8_e4m3fn>(),
+      width,
+      ids.size(1),
+      first,
+      static_cast<float>(input_scale));
+  check_musa_kernel_launch("V4.1 segmented expert pack with checkpoint scale");
+  auto up =
+      deepseek_v41_ragged_s4fp8_gemm(q,
+                                     torch::full({total, 1}, input_scale, f32),
+                                     gate_up,
+                                     gate_scale,
+                                     labels,
+                                     directory,
+                                     alignment);
+  q = torch::Tensor();
+  auto activated = torch::zeros({total, inner}, fp8);
+  ragged_swiglu_static<<<total, 256, 0, stream>>>(
+      up.data_ptr<c10::BFloat16>(),
+      labels.data_ptr<int32_t>(),
+      activated.data_ptr<c10::Float8_e4m3fn>(),
+      inner,
+      static_cast<float>(limit),
+      1.f / static_cast<float>(activation_scale));
+  check_musa_kernel_launch("V4.1 segmented expert static SwiGLU");
+  up = torch::Tensor();
+  auto projected = deepseek_v41_ragged_s4fp8_gemm(
+      activated,
+      torch::full({total, 1}, activation_scale, f32),
+      down,
+      down_scale,
+      labels,
+      directory,
+      alignment);
+  auto output = torch::empty(input.sizes(), f32);
+  const dim3 grid((width + 255) / 256, input.size(0));
+  ragged_combine_fp32<<<grid, 256, 0, stream>>>(
+      projected.data_ptr<c10::BFloat16>(),
+      links.data_ptr<int32_t>(),
+      weights.data_ptr<float>(),
+      output.data_ptr<float>(),
+      width,
+      ids.size(1));
+  check_musa_kernel_launch("V4.1 segmented expert FP32 weighted output");
+  LOG_FIRST_N(INFO, 4) << "V41_PREFILL_RAGGED_S4FP8 input=" << input.size(0)
+                       << " local_experts=" << e << " padded_rows=" << total
+                       << " inner=" << inner << " alignment=" << alignment;
+  return output;
+}
+
