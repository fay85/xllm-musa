diff --git a/xllm/core/layers/musa/deepseek_v41/prefill_tail.h b/xllm/core/layers/musa/deepseek_v41/prefill_tail.h
index d66a9a07c..36c900c3f 100644
--- a/xllm/core/layers/musa/deepseek_v41/prefill_tail.h
+++ b/xllm/core/layers/musa/deepseek_v41/prefill_tail.h
@@ -32,0 +33,18 @@ inline size_t deepseek_v41_rebalance_final_prefill_tail(size_t computed,
+}
+
+// Keep the large partitioned part on a window boundary and leave the
+// nondivisible final rows to the replicated attention path. Logical prompt
+// positions and the prefix of KV already committed by the scheduler stay exact.
+inline size_t deepseek_v41_bound_ragged_chunk(size_t computed,
+                                              size_t target,
+                                              size_t sequence,
+                                              size_t window,
+                                              size_t group_size) {
+  CHECK_GT(group_size, 0);
+  CHECK_GT(window, 0);
+  CHECK_EQ(window % group_size, 0);
+  const size_t count = target - computed;
+  if (target == sequence && count > 2 * window && count % group_size != 0) {
+    return computed + ((count - window) / window) * window;
+  }
+  return target;
