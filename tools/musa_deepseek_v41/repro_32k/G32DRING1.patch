diff --git a/tests/core/framework/request/request_params_test.cpp b/tests/core/framework/request/request_params_test.cpp
index 4744a8da3..30943b4fa 100644
--- a/tests/core/framework/request/request_params_test.cpp
+++ b/tests/core/framework/request/request_params_test.cpp
@@ -224,0 +225,18 @@ std::optional<Status> verify(const RequestParams& params) {
+TEST(RequestParamsTest, CompletionParsesRouterWireIdentity) {
+  // Router field 43 contains a length-delimited RequestCorrelation. Its field
+  // 4 is an optional uint64 attempt sequence. Explicit zero is a valid value.
+  const std::string wire("\xda\x02\x02\x20\x00", 5);
+  proto::CompletionRequest request;
+  ASSERT_TRUE(request.ParseFromString(wire));
+  RequestParams params(request, "", "");
+  EXPECT_EQ(params.v2_attempt_seq, 0u);
+  EXPECT_TRUE(params.logprob_token_ids.empty());
+  request.mutable_correlation()->set_attempt_seq(17);
+  request.add_logprob_token_ids(7);
+  RequestParams both(request, "", "");
+  EXPECT_EQ(both.v2_attempt_seq, 17u);
+  EXPECT_EQ(both.logprob_token_ids, std::vector<int32_t>{7});
+  request.clear_correlation();
+  EXPECT_FALSE(RequestParams(request, "", "").v2_attempt_seq.has_value());
+}
+
