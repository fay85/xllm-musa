#!/bin/bash
# Final link via mcc_wrapper -> g++: libtorch_cpu needs MKL DSOs at runtime only.
set -euo pipefail

# mcc_wrapper sometimes produces "-Xlinker -Wl,XXX" pairs, which pass
# "-Wl,XXX" verbatim to ld (ld does not understand -Wl, prefix).
# Convert them to "-Wl,XXX" so g++ handles the prefix correctly.
args=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "-Xlinker" && "${2:-}" == -Wl,* ]]; then
        args+=("$2")
        shift 2
    else
        args+=("$1")
        shift
    fi
done

exec /usr/bin/g++ "${args[@]}" -Wl,--allow-shlib-undefined
