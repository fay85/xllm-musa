+
+namespace mooncake {
+
+inline constexpr uint64_t kMusaIpcCopyTileBytes = 65536;
+
+// Device-visible descriptors, prepared only after validating independent
+// copies. tile_end is the cumulative exclusive number of 64KiB tiles in this
+// and all preceding spans. Source/destination are non-owning IPC/device
+// addresses.
+struct MusaIpcCopySpan final {
+    uint64_t source;
+    uint64_t destination;
+    uint64_t bytes;
+    uint64_t tile_end;
+};
+
+// The caller owns the descriptor array, endpoint mappings and buffers until its
+// stream has drained. This function neither allocates nor synchronizes. All
+// descriptors must contain positive lengths and strictly increasing tile_end.
+extern "C" musaError_t mooncake_musa_ipc_copy_kernel(
+    const MusaIpcCopySpan* device_spans, uint32_t span_count,
+    uint64_t tile_count, musaStream_t stream);
+
+}  // namespace mooncake
