+#include <musa_runtime.h>
+
+#include <cstdint>
+#include <limits>
+
+#include "transport/intranode_nvlink_transport/musa_ipc_copy_kernel.h"
+
+namespace mooncake {
+namespace {
+
+constexpr uint32_t kCopyThreads = 256;
+constexpr uint32_t kMaxCopyBlocks = 1024;
+constexpr uint64_t kVectorBytes = sizeof(uint4);
+
+__global__ void musa_ipc_scatter_copy(const MusaIpcCopySpan* spans,
+                                      uint32_t span_count,
+                                      uint64_t tile_count) {
+    __shared__ MusaIpcCopySpan selected_span;
+    __shared__ uint64_t selected_tile_begin;
+
+    for (uint64_t tile = blockIdx.x; tile < tile_count; tile += gridDim.x) {
+        if (threadIdx.x == 0) {
+            uint32_t begin = 0;
+            uint32_t end = span_count;
+            while (begin < end) {
+                const uint32_t middle = begin + (end - begin) / 2;
+                if (tile < spans[middle].tile_end) {
+                    end = middle;
+                } else {
+                    begin = middle + 1;
+                }
+            }
+            selected_span = spans[begin];
+            selected_tile_begin = begin == 0 ? 0 : spans[begin - 1].tile_end;
+        }
+        __syncthreads();
+
+        const MusaIpcCopySpan span = selected_span;
+        const uint64_t offset =
+            (tile - selected_tile_begin) * kMusaIpcCopyTileBytes;
+        const uint64_t remaining = span.bytes - offset;
+        const uint64_t bytes = remaining < kMusaIpcCopyTileBytes
+                                   ? remaining
+                                   : kMusaIpcCopyTileBytes;
+        const uint64_t source_address = span.source + offset;
+        const uint64_t destination_address = span.destination + offset;
+        const uint8_t* source = reinterpret_cast<const uint8_t*>(
+            static_cast<uintptr_t>(source_address));
+        uint8_t* destination = reinterpret_cast<uint8_t*>(
+            static_cast<uintptr_t>(destination_address));
+
+        if (((source_address | destination_address) & (kVectorBytes - 1)) ==
+            0) {
+            const uint64_t vectors = bytes / kVectorBytes;
+            const uint4* source_vectors =
+                reinterpret_cast<const uint4*>(source);
+            uint4* destination_vectors = reinterpret_cast<uint4*>(destination);
+            for (uint64_t index = threadIdx.x; index < vectors;
+                 index += blockDim.x) {
+                destination_vectors[index] = source_vectors[index];
+            }
+            for (uint64_t index = vectors * kVectorBytes + threadIdx.x;
+                 index < bytes; index += blockDim.x) {
+                destination[index] = source[index];
+            }
+        } else {
+            for (uint64_t index = threadIdx.x; index < bytes;
+                 index += blockDim.x) {
+                destination[index] = source[index];
+            }
+        }
+        // Every warp must finish using shared metadata before the next tile
+        // replaces it. Endpoint data are published only after the caller's
+        // stream drain.
+        __syncthreads();
+    }
+}
+
+}  // namespace
+
+extern "C" musaError_t mooncake_musa_ipc_copy_kernel(
+    const MusaIpcCopySpan* device_spans, uint32_t span_count,
+    uint64_t tile_count, musaStream_t stream) {
+    if (device_spans == nullptr || span_count == 0 || tile_count == 0 ||
+        tile_count > std::numeric_limits<uint32_t>::max()) {
+        return musaErrorInvalidValue;
+    }
+    const uint32_t blocks = tile_count < kMaxCopyBlocks
+                                ? static_cast<uint32_t>(tile_count)
+                                : kMaxCopyBlocks;
+    musa_ipc_scatter_copy<<<blocks, kCopyThreads, 0, stream>>>(
+        device_spans, span_count, tile_count);
+    return musaGetLastError();
+}
