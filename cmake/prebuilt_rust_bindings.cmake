# Opt-in reuse for immutable deployment images without a Rust toolchain.
# C++ objects are still rebuilt; a changed Rust input requires a Rust rebuild.
function(xllm_import_rust_binding name headers)
  if(NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64" OR
      NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "Prebuilt Rust bindings require x86_64 Release")
  endif()
  if(NOT XLLM_RUST_REFERENCE_SOURCE OR NOT XLLM_RUST_REFERENCE_BUILD)
    message(FATAL_ERROR "Set both XLLM_RUST_REFERENCE_SOURCE and XLLM_RUST_REFERENCE_BUILD")
  endif()
  file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}")
  set(reference "${XLLM_RUST_REFERENCE_SOURCE}/${relative}")
  file(GLOB_RECURSE inputs RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/*.rs")
  file(GLOB_RECURSE reference_inputs RELATIVE "${reference}" "${reference}/*.rs")
  list(SORT inputs)
  list(SORT reference_inputs)
  if(NOT "${inputs}" STREQUAL "${reference_inputs}")
    message(FATAL_ERROR "Rust source file set differs; rebuild with Cargo: ${relative}")
  endif()
  list(APPEND inputs Cargo.toml ${headers})
  if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/Cargo.lock")
    list(APPEND inputs Cargo.lock)
  endif()
  foreach(input IN LISTS inputs)
    if(NOT EXISTS "${reference}/${input}")
      message(FATAL_ERROR "Missing reference Rust input: ${reference}/${input}")
    endif()
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${input}" actual)
    file(SHA256 "${reference}/${input}" expected)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Rust input differs; rebuild with Cargo: ${relative}/${input}")
    endif()
  endforeach()
  set(archive "${XLLM_RUST_REFERENCE_BUILD}/${relative}/x86_64-unknown-linux-gnu/release/lib${name}.a")
  if(NOT EXISTS "${archive}")
    message(FATAL_ERROR "Missing prebuilt Rust archive: ${archive}")
  endif()
  file(SHA256 "${archive}" archive_sha256)
  message(STATUS "Validated unchanged Rust inputs for ${name}; archive SHA256=${archive_sha256}")
  file(APPEND "${CMAKE_BINARY_DIR}/rust_binding_provenance.txt"
    "${name} ${archive_sha256} ${archive}\n")
  add_library(${name} STATIC IMPORTED GLOBAL)
  set_target_properties(${name} PROPERTIES IMPORTED_LOCATION "${archive}")
  target_sources(${name} INTERFACE ${headers})
endfunction()
